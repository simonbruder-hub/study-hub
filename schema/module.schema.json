{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module.schema.json",
  "title": "Module (inhalt/module.yaml)",
  "description": "Module mit Formeln im Formelbuch. Das Kürzel ist dasselbe wie in der Ablage (Studienplan in Supabase). Name und Semester pflegt die Ablage, der Name hier dient dem Formelbuch ohne Login.",
  "type": "object",
  "propertyNames": { "$ref": "gemeinsam.schema.json#/$defs/modul" },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title"],
    "properties": {
      "title": { "$ref": "gemeinsam.schema.json#/$defs/text" },
      "tools": {
        "type": "array",
        "items": { "$ref": "gemeinsam.schema.json#/$defs/tool" },
        "uniqueItems": true,
        "description": "Simulationswerkzeuge, die dieses Modul verwendet"
      }
    }
  }
}
