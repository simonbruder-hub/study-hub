{
  "name": "study-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Study Hub: Ablage für Formelsammlungen und Prüfungen, später vernetztes Formelbuch mit Simulationen und Lernhilfen",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:test": "bash supabase/test/run.sh",
    "inhalt": "node scripts/inhalt.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "@supabase/supabase-js": "2.118.0",
    "katex": "^0.19.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "ajv": "^8.17.1",
    "typescript": "7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.5",
    "yaml": "^2.8.1"
  }
}
